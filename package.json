{
  "name": "react-keyboard-map",
  "version": "0.1.0",
  "description": "A customizable React component for visualizing keyboard layouts, physical key presses, hotkeys, and color-coded key zones.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "keyboard",
    "keyboard-layout",
    "hotkeys",
    "keymap",
    "ansi",
    "iso",
    "mcp"
  ],
  "homepage": "https://github.com/earoglif/react-keyboard-map#readme",
  "bugs": {
    "url": "https://github.com/earoglif/react-keyboard-map/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earoglif/react-keyboard-map.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "bin": {
    "react-keyboard-map-mcp": "./dist/mcp/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode lib && vite build --config vite.mcp.config.ts && tsc -p tsconfig.lib.json && tsc -p tsconfig.mcp.json && node scripts/rewrite-declaration-extensions.mjs",
    "prepack": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^1.63.0",
    "zod": "^4.6.7"
  }
}
